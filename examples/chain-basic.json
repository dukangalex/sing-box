{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "entry",
      "server": "entry.example.com",
      "server_port": 8388,
      "method": "aes-256-gcm",
      "password": "password"
    },
    {
      "type": "vless",
      "tag": "exit",
      "server": "exit.example.com",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "tls": {
        "enabled": true,
        "server_name": "exit.example.com"
      }
    },
    {
      "type": "chain",
      "tag": "my-chain",
      "outbounds": ["entry", "exit"]
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "my-chain"
  }
}
